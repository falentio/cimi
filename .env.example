# Directory holding cimi's local state: control.sqlite and analytics.duckdb.
CIMI_DATA_DIR=.cimi

# Better Auth secret (required). Generate one, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me

# Base URL Better Auth uses for callbacks and cookies.
BETTER_AUTH_URL=http://localhost:4321

# Optional event-ingestion protection thresholds.
# CIMI_EVENT_SITE_RATE_PER_SECOND=120
# CIMI_EVENT_SITE_BURST=600
# CIMI_EVENT_SOURCE_IP_RATE_PER_SECOND=30
# CIMI_EVENT_SOURCE_IP_BURST=150
# CIMI_EVENT_TRUST_PROXY_HEADERS=false
